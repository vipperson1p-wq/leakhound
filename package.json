{
  "name": "leakhound",
  "version": "0.1.1",
  "description": "Security scanner for vibe-coded Next.js / Vite + Supabase apps: leaked keys, public env secrets, .env in git, missing RLS",
  "type": "module",
  "main": "./src/api.js",
  "bin": {
    "leakhound": "src/index.js"
  },
  "files": [
    "src/",
    "skills/",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "scan": "node src/index.js",
    "test": "node --test",
    "scan:fixture": "node src/index.js test-project",
    "scan:self": "node src/index.js ."
  },
  "keywords": [
    "security",
    "scanner",
    "secrets",
    "supabase",
    "rls",
    "nextjs",
    "vite",
    "vibe-coding",
    "pre-commit",
    "env",
    "api-keys"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipperson1p-wq/leakhound.git"
  },
  "bugs": {
    "url": "https://github.com/vipperson1p-wq/leakhound/issues"
  },
  "homepage": "https://github.com/vipperson1p-wq/leakhound#readme",
  "license": "MIT"
}
